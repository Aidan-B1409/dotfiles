#!/usr/bin/env bash

set -e

profile=hpc
case "${1:-}" in
    hpc|workstation) profile=$1; shift ;;
    -h|--help) echo "Usage: ./install [hpc|workstation] [dotbot options] (default: hpc)"; exit 0 ;;
    ""|-*) ;;
    *) echo "Unknown profile: $1 (expected hpc or workstation)" >&2; exit 2 ;;
esac

cd "$(dirname "${BASH_SOURCE[0]}")"
git submodule sync --quiet --recursive -- dotbot
git submodule update --init --recursive -- dotbot

exec dotbot/bin/dotbot -d "$PWD" --exit-on-failure \
    -c install.conf.yaml "install.$profile.conf.yaml" "$@"
